# ── Raghuvir Consultants Production Environment Variables ────────────────────

# MongoDB Database Connection String (Atlas or Self-Hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/raghuvir_db?retryWrites=true&w=majority

# Db name
DB_NAME=raghuvir_consultants


# JWT Token Signing Secret Key (Generate a random 64-char string: openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# Allowed CORS Origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=https://www.raghuvirconsultants.in,https://raghuvirconsultants.in,https://admin.raghuvirconsultants.in

# Host Port Mappings (Optional overrides)
FRONTEND_PORT=80
ADMIN_PORT=8080
BACKEND_PORT=8000

# Google OAuth Client ID (Optional / Baked into Frontend & Admin builds)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
